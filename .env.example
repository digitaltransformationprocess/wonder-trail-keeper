# Copy to .env for local development. Do not commit .env.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=http://localhost:5173

# Google Search Console / Bing Webmaster (optional — paste verification codes)
# GSC → Settings → Ownership verification → HTML tag → content="...."
VITE_GOOGLE_SITE_VERIFICATION=
# Bing → HTML meta tag → content="...."
VITE_BING_SITE_VERIFICATION=

# Server-only (backfill / admin scripts) — never commit real values
SUPABASE_SECRET_KEY=
# or legacy:
# SUPABASE_SERVICE_ROLE_KEY=

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
